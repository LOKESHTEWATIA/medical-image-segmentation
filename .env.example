# MedSeg Environment Configuration
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!

# Application
APP_NAME="MedSeg - Medical Image Segmentation"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=true
API_PREFIX="/api/v1"

# Security - GENERATE A STRONG SECRET KEY FOR PRODUCTION!
# Use: openssl rand -base64 32
SECRET_KEY=your-super-secret-key-min-32-chars-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=12
BCRYPT_ROUNDS=12

# CORS - Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://medseg:changeme@localhost:5432/medseg
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=300

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=524288000  # 500MB in bytes
ALLOWED_EXTENSIONS=.nii,.nii.gz,.dcm,.dicom,.mha,.mhd
ALLOWED_MIME_TYPES=application/octet-stream,application/dicom,image/x-nifti,application/x-nifti

# Model
MODEL_DIR=./models
DEFAULT_MODEL=unet_brats
DEVICE=cpu  # cuda or cpu
INFERENCE_BATCH_SIZE=1

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
UPLOAD_RATE_LIMIT=10
UPLOAD_RATE_WINDOW=3600

# Audit Logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=2555  # 7 years for HIPAA

# Email (optional - for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
FROM_EMAIL=noreply@medseg.local

# Monitoring
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# HIPAA / Compliance
ENCRYPTION_KEY=  # Generate with: openssl rand -base64 32
SESSION_TIMEOUT_MINUTES=15
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30

# Flower (Celery monitoring)
FLOWER_USER=admin
FLOWER_PASSWORD=changeme